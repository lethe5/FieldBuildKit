# Example development configuration. Copy to `.env` for local use and adjust as needed.
# Do not commit a real `.env` file, and do not put secrets in this example file.
#
# These are storage *locations*, not a storage backend decision. In this example they point
# at local paths under storage/ (see .gitignore and docs/architecture.md). A deployed
# environment may instead map them to Docker volumes, bind mounts, dedicated server storage,
# or an object-storage-backed implementation (e.g. S3-compatible storage) behind the same
# variable names — which backend to use is an open architectural decision, not made here.

# Reference geospatial datasets (rasters/vectors) used by the application.
REFERENCE_DATA_DIR=storage/reference

# Original files as uploaded by users, before any processing.
UPLOAD_DATA_DIR=storage/uploads

# Temporary / reproducible intermediate processing files. Safe to clear per a retention policy.
WORK_DATA_DIR=storage/work

# Generated QField project packages and related outputs.
GENERATED_PROJECT_DIR=storage/projects
