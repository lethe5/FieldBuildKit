      <constraintExpressions>
        <constraint exp="" field="fid" desc="" />
        <constraint exp="" field="inventory_id" desc="" />
        <constraint exp="" field="observed_at" desc="" />
        <constraint exp="length(trim(surveyor)) &gt; 0" field="surveyor" desc="surveyor" />
        <constraint exp="" field="selected_korean_name" desc="" />
        <constraint exp="" field="selected_scientific_name" desc="" />
        <constraint exp="" field="selected_ktsn" desc="" />
        <constraint exp="identification_score IS NULL OR (identification_score &gt;= 0.0 AND identification_score &lt;= 1.0)" field="identification_score" desc="reserved; nullable/inactive until post-MVP identification subsystem ships" />
        <constraint exp="occurrence_probability IS NULL OR (occurrence_probability &gt;= 0.0 AND occurrence_probability &lt;= 1.0)" field="occurrence_probability" desc="reserved; nullable/inactive until post-MVP identification subsystem ships" />
        <constraint exp="" field="identification_timestamp" desc="" />
        <constraint exp="" field="identification_model_version" desc="" />
        <constraint exp="leaf_photo_path IS NULL OR (length(trim(leaf_photo_path)) &gt; 0 AND NOT regexp_match(leaf_photo_path, '^/') AND NOT regexp_match(leaf_photo_path, '^[A-Za-z]:[\\\\/]') AND NOT regexp_match(leaf_photo_path, '^\\\\') AND NOT regexp_match(leaf_photo_path, '^[A-Za-z][A-Za-z0-9+.-]*://'))" field="leaf_photo_path" desc="must be a well-formed relative attachment path" />
        <constraint exp="flower_photo_path IS NULL OR (length(trim(flower_photo_path)) &gt; 0 AND NOT regexp_match(flower_photo_path, '^/') AND NOT regexp_match(flower_photo_path, '^[A-Za-z]:[\\\\/]') AND NOT regexp_match(flower_photo_path, '^\\\\') AND NOT regexp_match(flower_photo_path, '^[A-Za-z][A-Za-z0-9+.-]*://'))" field="flower_photo_path" desc="must be a well-formed relative attachment path" />
        <constraint exp="fruit_photo_path IS NULL OR (length(trim(fruit_photo_path)) &gt; 0 AND NOT regexp_match(fruit_photo_path, '^/') AND NOT regexp_match(fruit_photo_path, '^[A-Za-z]:[\\\\/]') AND NOT regexp_match(fruit_photo_path, '^\\\\') AND NOT regexp_match(fruit_photo_path, '^[A-Za-z][A-Za-z0-9+.-]*://'))" field="fruit_photo_path" desc="must be a well-formed relative attachment path" />
        <constraint exp="identification_status IN ('not_requested', 'pending', 'complete', 'failed', 'manual')" field="identification_status" desc="not_requested in MVP; post-MVP adds pending/complete/failed/manual" />
        <constraint exp="" field="notes" desc="" />
      </constraintExpressions>
